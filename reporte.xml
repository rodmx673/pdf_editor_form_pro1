.app-branding span { font-size: 10px; font-weight: bold; letter-spacing: 1.5px; color: #888; }

/* EDITOR MODE */
body.editing-mode { height: 100vh; overflow: hidden; }
body.editing-mode .app-main { position: absolute; top: 0; left: 0; width: 100%; height: 100vh; }
body.editing-mode header { position: fixed; top: 0; left: 0; width: 100%; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(15px); border-bottom: 1px solid rgba(0,0,0,0.1); transition: transform 0.4s; }
