.pdf-container { flex: 1; overflow-y: auto; overflow-x: hidden; display: flex; flex-direction: column; align-items: center; padding: 15px; padding-top: 130px; padding-bottom: 50px; scroll-snap-type: y mandatory; transition: padding-top 0.3s ease; }
body.header-hidden .pdf-container { padding-top: 15px; }
.pdf-page { position: relative; margin-bottom: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.15); background: white; border-radius: 8px; overflow: hidden; scroll-snap-align: center; max-width: 100%; width: 100%; display: flex; justify-content: center; }
