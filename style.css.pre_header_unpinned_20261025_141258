        padding-top: 260px !important;
    }
}

/* ==========================================
   PESTAÑA FLOTANTE PARA MOSTRAR HEADER
   Aparece solo cuando el header está oculto
   ========================================== */

.header-peek-tab {
    display: none;              /* Oculta por defecto */
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%) translateY(-100%);
    background: linear-gradient(135deg, #0071e3, #005bb5);
    color: #fff;
    border: none;
    border-radius: 0 0 12px 12px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
    z-index: 999;
    box-shadow: 0 4px 12px rgba(0, 113, 227, 0.4);
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.2s;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    opacity: 0;
}

/* Cuando el body tiene la clase header-hidden, la pestaña aparece */
body.header-hidden .header-peek-tab,
body.header-unpinned .header-peek-tab {
    display: flex;
    transform: translateX(-50%) translateY(0);
    opacity: 1;
}

.header-peek-tab:hover {
    background: linear-gradient(135deg, #005bb5, #004494);
    transform: translateX(-50%) translateY(2px);
}

.header-peek-tab:active {
    transform: translateX(-50%) translateY(4px);
}

/* Icono animado (rebote) */
.header-peek-tab .peek-icon {
    display: inline-block;
    animation: peek-bounce 2s ease-in-out infinite;
}

@keyframes peek-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
}

/* Modo oscuro */
body.dark-mode .header-peek-tab {
    background: linear-gradient(135deg, #0071e3, #005bb5);
    box-shadow: 0 4px 12px rgba(0, 113, 227, 0.6);
}

/* Responsive móvil */
@media (max-width: 768px) {
    .header-peek-tab {
        padding: 7px 16px;
        font-size: 12px;
        border-radius: 0 0 10px 10px;
    }
    
    .header-peek-tab .peek-label {
        font-size: 11px;
    }
}

/* ── Ocultar el checkbox "Anclar" fuera del editor ── */
body:not(.editing-mode) .header-pin-label {
    display: none !important;
}
