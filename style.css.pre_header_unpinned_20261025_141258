}

/* ==========================================
   MENÚ FLOTANTE (FLEXIBLE Y RESPONSIVO)
   ========================================== */
.floating-popover {
    position: fixed;
    display: none;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(15px);
