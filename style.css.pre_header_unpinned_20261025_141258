}

@keyframes pulse-badge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.25); }
}

body.dark-mode .header-action-btn {
    background: #2c2c2e;
    color: #fff;
    border-color: #444;
}

body.dark-mode .header-action-btn:hover {
    background: #3a3a3c;
}

body.dark-mode .header-action-primary {
