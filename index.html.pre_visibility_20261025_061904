<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PDF Edit Forms</title>
    <link rel="icon" href="data:image/x-icon;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=">
    <link rel="stylesheet" href="style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
</head>
<body>

<header id="mainHeader">
    <div class="header-toggles">
        <button id="langToggle" class="toggle-btn">🇲🇽 ES</button>
        <button id="themeToggle" class="toggle-btn">🌙</button>
    </div>
    <img src="logo.png" alt="pdfeditforms.com" class="main-logo">
    
    <div id="stepper" class="stepper-container">
        <div class="step active" id="step-1"><span>1</span> <span>Subir</span></div>
        <div class="step-line"></div>
        <div class="step" id="step-2"><span>2</span> <span>Procesar</span></div>
        <div class="step-line"></div>
        <div class="step" id="step-3"><span>3</span> <span>Editar</span></div>
        <div class="step-line"></div>
        <div class="step" id="step-4"><span>4</span> <span>Descargar</span></div>
    </div>
</header>

<main class="app-main">
    <div id="uploadView" class="view">
        <label class="upload-area" id="uploadArea">
            <input type="file" id="fileInput" accept=".pdf" style="position: absolute; opacity: 0; width: 0; height: 0;">
            <div class="upload-icon">📄</div>
            <p>Arrastra tu PDF aquí o haz clic para seleccionar</p>
        </label>
        <div class="app-branding">
            <div class="app-icon-container" id="appIconSpinner"><img src="app-icon.png" alt="App Icon"></div>
            <span>PDF EDIT FORMS APP</span>
        </div>
    </div>
    
    <div id="editorView" class="view" style="display: none;">
        <div id="hamburgerMenu">
            <button id="hamburgerBtn">☰</button>
            <div id="hamburgerDropdown">
                <button id="fillModeBtn" class="btn-tool" style="width: 100%; text-align: left; font-weight: bold; color: #0071e3;">✍️ Modo Llenado</button>
                <button id="saveBtn" class="btn-tool btn-primary" style="width: 100%; text-align: left;">💾 Guardar</button>
                <a id="downloadBtn" class="btn-tool btn-success" style="display: none; width: 100%; text-align: left; box-sizing: border-box; margin-bottom: 5px;">⬇ Descargar Editable</a>
<button id="downloadSealedBtn" class="btn-tool" style="display: none; width: 100%; text-align: left; background-color: #ff6b00; color: white; border: none; font-weight: bold;">🔒 Descargar Sellado (No editable)</button>
                <button id="resetBtn" class="btn-tool" style="width: 100%; text-align: left;">↺ Reiniciar</button>
                <button id="toggleHeaderBtn" class="btn-tool" style="width: 100%; text-align: left;">👁 Header</button>
                <button id="openPricingBtn" class="btn-tool" style="width: 100%; text-align: left; color: #ff6b00; font-weight: bold;">💳 Planes y Precios</button>
            </div>
        </div>

        <div class="pdf-container" id="pdfContainer"><div id="pdfPages"></div></div>
        
        <button id="zoomBtn" class="zoom-fab">🔍 +</button>
        <button id="addFieldBtn" class="fab-pencil" title="Dibujar campo manual">✏️</button>
    </div>
</main>

<div id="floatingToolbar" class="floating-popover">
    <div class="popover-header">
        <span id="popoverTitle">Editar Campo</span>
        <div style="display: flex; gap: 8px;">
            <button id="helpBtn" class="icon-btn" title="Ayuda">?</button>
            <button id="closePopover" class="icon-btn">✕</button>
        </div>
    </div>
    
    <div id="helpTooltip">
        <strong>Guía rápida:</strong><br>
        • Usa <strong>Celdas</strong> para dividir el texto (ej. CURP o NIP).
        • Para dibujar un campo desde cero, usa el botón del <strong>Lápiz</strong> (✏️).
    </div>

    <div id="fieldProperties">
        <div class="prop-item text-only-option">
            <label>Tipo</label>
            <select id="propType"><option value="text">Texto</option><option value="number">Número</option><option value="checkbox">Checkbox</option></select>
        </div>
        <div class="prop-item text-only-option">
            <label>Celdas</label>
            <input type="number" id="propCells" value="0" min="0">
        </div>
        <div class="prop-item text-only-option">
            <label>Fuente</label>
            <input type="number" id="propFontSize" value="10">
        </div>
        <div class="prop-item text-only-option">
            <label>Alinear</label>
            <select id="propAlign"><option value="left">Izquierda</option><option value="center">Centro</option><option value="right">Derecha</option></select>
        </div>
        <div class="action-buttons">
            <button id="saveFieldBtn" class="btn-tool" style="background: #28a745; color: white; border: none; margin-top: 15px; padding: 8px 12px;">💾 Guardar</button>
            <button id="cancelFieldBtn" class="btn-tool" style="background: #dc3545; color: white; border: none; margin-top: 15px; padding: 8px 12px;">❌ Cancelar</button>
            <button id="deleteField" class="btn-tool btn-danger" style="margin-top: 15px; padding: 8px 12px;">🗑️ Borrar</button>
        </div>
    </div>
</div>

<script src="script.js"></script>
<div id="toastContainer" style="position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); z-index: 99999; display: flex; flex-direction: column; gap: 10px; align-items: center;"></div>

<!-- MODAL DE PRECIOS -->
<div id="pricingModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); z-index: 20000; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #fff; border-radius: 16px; padding: 30px; max-width: 800px; width: 100%; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;">
        <button id="closePricingBtn" style="position: absolute; top: 15px; right: 15px; background: #f0f0f5; border: none; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 16px; font-weight: bold;">✕</button>
        
        <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="margin: 0 0 10px 0; color: #1d1d1f; font-size: 26px;">Elige tu Plan</h2>
            <p style="margin: 0; color: #666; font-size: 15px;">Rellena tus formularios y descárgalos listos para usar.</p>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
            
            <!-- PLAN 1 -->
            <div style="flex: 1; min-width: 280px; border: 2px solid #ff6b00; border-radius: 12px; padding: 25px; text-align: center; position: relative; background: #fff9f5;">
                <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #ff6b00; color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold;">MÁS POPULAR</div>
                <h3 style="margin: 0 0 10px 0; color: #1d1d1f; font-size: 20px;">Plan Básico</h3>
                <div style="font-size: 36px; font-weight: bold; color: #1d1d1f; margin-bottom: 15px;">$1.99 <span style="font-size: 16px; color: #666; font-weight: normal;">USD</span></div>
                <ul style="list-style: none; padding: 0; margin: 0 0 25px 0; text-align: left; color: #444; font-size: 14px; line-height: 1.8;">
                    <li>✅ 1 a 3 Páginas</li>
                    <li>✅ Rellenable en la web</li>
                    <li>✅ Descarga en PDF lleno (no editable)</li>
                    <li>✅ Detección automática de páginas</li>
                </ul>
                <button style="width: 100%; padding: 12px; background: #ff6b00; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.3s;">Comprar Plan Básico</button>
            </div>

            <!-- PLAN 2 -->
            <div style="flex: 1; min-width: 280px; border: 1px solid #ddd; border-radius: 12px; padding: 25px; text-align: center; background: #fff;">
                <h3 style="margin: 0 0 10px 0; color: #1d1d1f; font-size: 20px;">Plan Pro</h3>
                <div style="font-size: 36px; font-weight: bold; color: #1d1d1f; margin-bottom: 15px;">$4.99 <span style="font-size: 16px; color: #666; font-weight: normal;">USD</span></div>
                <ul style="list-style: none; padding: 0; margin: 0 0 25px 0; text-align: left; color: #444; font-size: 14px; line-height: 1.8;">
                    <li>✅ 1 a 5 Páginas</li>
                    <li>✅ Rellenable en la web</li>
                    <li>✅ Descarga en PDF lleno (no editable)</li>
                    <li>✅ Detección automática de páginas</li>
                </ul>
                <button style="width: 100%; padding: 12px; background: #0071e3; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; transition: background 0.3s;">Comprar Plan Pro</button>
            </div>

        </div>

        <!-- Footer del Modal -->
        <div style="margin-top: 30px; text-align: center; border-top: 1px solid #eaeaea; padding-top: 20px; font-size: 14px; color: #666;">
            <p style="margin: 0 0 10px 0;">¿Tienes dudas? Contáctanos:</p>
            <div style="display: flex; justify-content: center; gap: 20px;">
                <a href="mailto:pdfeditforms@gmail.com" style="color: #0071e3; text-decoration: none; font-weight: bold;">📧 pdfeditforms@gmail.com</a>
                <a href="https://www.facebook.com/editforms/" target="_blank" style="color: #1877f2; text-decoration: none; font-weight: bold;">📘 Facebook</a>
            </div>
        </div>
    </div>
</div>

</body>
</html>



