/* ==========================================
   POPOVER FLOTANTE (REDISEÑO HORIZONTAL Y DRAG)
   ========================================== */
.floating-popover {
    position: fixed;
    display: none;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid #ddd;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    padding: 8px 12px;
    z-index: 10000;
    width: auto;
    min-width: 300px;
    max-width: 90vw;
    /* Quitamos el transform de aquí para manejarlo con JS */
}

.popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid #eee;
    cursor: grab; /* Cursor de arrastre */
}
.popover-header:active { cursor: grabbing; }

#popoverTitle {
    font-size: 11px;
    font-weight: bold;
    color: #333;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 150px;
}

.icon-btn {
    background: #f0f0f5;
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    cursor: pointer;
    font-weight: bold;
    color: #555;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}
.icon-btn:hover { background: #e0e0e5; }

/* Hacer las propiedades horizontales */
#fieldProperties {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    align-items: center;
    overflow-x: auto;
}
#fieldProperties::-webkit-scrollbar { display: none; }

.prop-item {
