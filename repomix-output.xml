    box-shadow: 0 0 15px rgba(220, 53, 69, 0.5) !important;
}

/* ==========================================
   NOTIFICACIONES TOAST
   ========================================== */
.toast {
    padding: 12px 20px;
    border-radius: 8px;
    color: white;
    font-weight: bold;
    font-size: 14px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
