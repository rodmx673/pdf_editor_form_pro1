    gap: 10px;
    justify-content: center;
}

/* Contenedor de botones de acción (Guardar, Cancelar, Borrar) */
.action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
    justify-content: center;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #eee;
}

