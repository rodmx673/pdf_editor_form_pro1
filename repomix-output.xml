    const dx = e.clientX - popoverStartX;
    const dy = e.clientY - popoverStartY;
    popover.style.left = (popoverStartLeft + dx) + 'px';
    popover.style.top = (popoverStartTop + dy) + 'px';
});

document.addEventListener('touchmove', (e) => {
