body.dark-mode header { background: rgba(28, 28, 30, 0.85); border-bottom: 1px solid #333; }
body.dark-mode .toggle-btn { background: #2c2c2e; color: white; }
body.dark-mode .upload-area { background: #1c1c1e; border-color: #444; }
body.dark-mode .upload-area p { color: #aaa; }
body.dark-mode #hamburgerBtn, body.dark-mode #hamburgerDropdown { background: #1c1c1e; border-color: #333; }
body.dark-mode .btn-tool { background: #2c2c2e; border-color: #444; color: white; }
