/* ==========================================
   LATIDO DEL PUNTO ACTIVO EN EL STEPPER
   ========================================== */
@keyframes pulse-blue {
    0%   { box-shadow: 0 0 0 0   rgba(0, 113, 227, 0.7); }
    70%  { box-shadow: 0 0 0 8px rgba(0, 113, 227, 0); }
    100% { box-shadow: 0 0 0 0   rgba(0, 113, 227, 0); }
}

.step.active span:first-child {
    animation: pulse-blue 1.5s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
    .step.active span:first-child {
        animation: none;
    }
}
/* ==========================================
   BOTÓN DE EDICIÓN "MÁS" (+) FLOTANTE
   Encima del campo con línea conectora vertical
   ========================================== */

/* Wrapper del botón: se posiciona encima del field-rect */
.field-rect .edit-btn-wrapper {
    position: absolute;
    top: -22px;                    /* flota 22px arriba del recuadro */
    right: -12px;                  /* alineado a la derecha, sobresale un poco */
    width: 24px;
    height: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 110;
    pointer-events: none;          /* invisible por defecto para clics */
    opacity: 0;
    visibility: hidden;
    transform: scale(0.8);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
}

/* Mostrar al hacer hover o focus sobre el campo */
.field-rect:hover .edit-btn-wrapper,
.field-rect:focus-within .edit-btn-wrapper {
    opacity: 0.55;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
}

/* Iluminar totalmente cuando el mouse está SOBRE el botón */
.field-rect .edit-btn-wrapper:hover {
    opacity: 1 !important;
}

/* Botón circular con + */
.field-rect .inline-edit-btn {
    /* Resetear estilos anteriores */
    position: relative;
    top: 0;
    right: 0;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 1.5px solid #ffffff;
    background: #ff6b00;
    color: #ffffff;
    border-radius: 50%;
    font-size: 14px;
    font-weight: bold;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,0,0,0.25);
    /* Animación al hover */
    transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    /* Resetear opacidades viejas */
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.field-rect .inline-edit-btn:hover {
    background: #e65c00;
    transform: scale(1.15);
    box-shadow: 0 0 10px rgba(255, 107, 0, 0.6);
}

/* Línea vertical conectora entre el botón y el campo */
.field-rect .inline-edit-btn::after {
    content: '';
    position: absolute;
    top: 100%;                     /* empieza donde termina el botón */
    left: 50%;
    transform: translateX(-50%);
    width: 1.5px;
    height: 12px;                  /* largo de la línea conectora */
    background: #ff6b00;
    border-radius: 1px;
}

/* Modo oscuro */
body.dark-mode .field-rect .inline-edit-btn {
    border-color: #1c1c1e;
    background: #ff6b00;
    color: #ffffff;
}
body.dark-mode .field-rect .inline-edit-btn:hover {
    background: #ff8533;
}
body.dark-mode .field-rect .inline-edit-btn::after {
    background: #ff6b00;
}

/* ==========================================
   MODO "OCULTAR CAMPOS" (transparente)
   ========================================== */

