    }
    isFillMode = !isFillMode;
    const btn = document.getElementById('fillModeBtn');
    btn.textContent = isFillMode ? '✏️ Modo Edición' : '✍️ Modo Llenado';
    btn.style.color = isFillMode ? '#28a745' : '#0071e3';
