}

/* ==========================================
   CORRECCIÓN: BOTÓN HAMBURGUESA Y DROPDOWN
   ========================================== */

/* Modo Claro */
#hamburgerBtn {
    background: #ffffff;
    color: #333333;
    border: 1px solid #eaeaea;
}
#hamburgerDropdown {
    background: #ffffff;
    border: 1px solid #eaeaea;
}

/* Modo Oscuro */
body.dark-mode #hamburgerBtn {
    background: #2c2c2e;
    color: #ffffff;
    border: 1px solid #444;
}
body.dark-mode #hamburgerDropdown {
    background: #1c1c1e;
