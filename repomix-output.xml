body.dark-mode #helpTooltip { background: #333; color: #ccc; }

/* ==========================================
   EFECTO DE CARGA (ANILLO Y RECUADRO NARANJA)
   ========================================== */
@keyframes spin-orange {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

@keyframes pulse-glow {
    0% { box-shadow: 0 0 10px rgba(255, 107, 0, 0.4); }
    50% { box-shadow: 0 0 30px rgba(255, 107, 0, 0.9); }
    100% { box-shadow: 0 0 10px rgba(255, 107, 0, 0.4); }
}

/* Contenedor del icono para el anillo */
.app-icon-container {
    position: relative;
    width: 120px !important;
    height: 120px !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 15px !important;
    box-sizing: border-box;
    border-radius: 50%;
    margin: 40px auto 0 auto !important;
    transition: all 0.3s ease;
}

.app-icon-container img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 2;
}

/* El anillo de luz giratorio */
.app-icon-container.processing::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0%, rgba(255, 107, 0, 0.1) 40%, #ff6b00 90%, #ff6b00 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 8px), #000 calc(100% - 8px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 8px), #000 calc(100% - 8px));
    animation: spin-orange 1.2s linear infinite, pulse-glow 2s ease-in-out infinite;
    z-index: 1;
}

/* Recuadro naranja al procesar */
#uploadArea.processing {
    background-color: rgba(255, 107, 0, 0.05) !important;
    border: 2px dashed #ff6b00 !important;
    box-shadow: 0 0 15px rgba(255, 107, 0, 0.2);
}

#uploadArea.processing p {
    color: #ff6b00 !important;
    font-weight: bold;
}

/* Recuadro naranja en modo oscuro */
body.dark-mode #uploadArea.processing {
    background-color: rgba(255, 107, 0, 0.15) !important;
}

/* ==========================================
   CORRECCIÓN: BOTÓN HAMBURGUESA Y DROPDOWN
   ========================================== */

/* Modo Claro */
#hamburgerBtn {
    background: #ffffff;
    color: #333333;
    border: 1px solid #eaeaea;
}
#hamburgerDropdown {
    background: #ffffff;
    border: 1px solid #eaeaea;
}

/* Modo Oscuro */
body.dark-mode #hamburgerBtn {
    background: #2c2c2e;
    color: #ffffff;
    border: 1px solid #444;
}
body.dark-mode #hamburgerDropdown {
    background: #1c1c1e;
    border: 1px solid #444;
}
body.dark-mode #hamburgerDropdown .btn-tool {
    background: #2c2c2e;
    color: #ffffff;
    border: 1px solid #444;
}
body.dark-mode #hamburgerDropdown .btn-tool:hover {
    background: #3a3a3c;
}

/* ==========================================
   ESTILO PARA CAMPOS EDITADOS (NARANJA)
   ========================================== */
.field-rect.edited-field {
    border: 2px solid #ff6b00 !important;
    background-color: rgba(255, 107, 0, 0.15) !important;
}



/* ==========================================
   POPOVER FLOTANTE (REDISEÑO HORIZONTAL Y DRAG)
   ========================================== */
.floating-popover {
    position: fixed;
    display: none;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid #ddd;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    padding: 8px 12px;
    z-index: 10000;
    width: auto;
    min-width: 300px;
    max-width: 90vw;
    /* Quitamos el transform de aquí para manejarlo con JS */
}

.popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid #eee;
    cursor: grab; /* Cursor de arrastre */
}
.popover-header:active { cursor: grabbing; }

#popoverTitle {
    font-size: 11px;
    font-weight: bold;
    color: #333;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 150px;
}

.icon-btn {
    background: #f0f0f5;
    border: none;
    border-radius: 50%;
    width: 22px;
    height: 22px;
    cursor: pointer;
    font-weight: bold;
    color: #555;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}
.icon-btn:hover { background: #e0e0e5; }

/* Hacer las propiedades horizontales */
#fieldProperties {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    align-items: center;
    overflow-x: auto;
}
#fieldProperties::-webkit-scrollbar { display: none; }

.prop-item {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    min-width: 50px;
}
.prop-item label {
    font-size: 9px;
    color: #888;
    font-weight: bold;
    margin-bottom: 2px;
    text-transform: uppercase;
}
.prop-item input, .prop-item select {
    padding: 4px;
    border-radius: 6px;
    border: 1px solid #ccc;
    font-size: 11px;
    width: 100%;
}

/* Botón de borrar más compacto */
.btn-danger {
    padding: 4px 8px;
    font-size: 11px;
    margin-top: 15px; /* Alinearlo con los inputs */
}

/* Modo oscuro para el popover */
body.dark-mode .floating-popover {
    background: rgba(28, 28, 30, 0.95);
    border-color: #444;
}
body.dark-mode .popover-header { border-bottom-color: #444; }
body.dark-mode #popoverTitle { color: #eee; }
body.dark-mode .icon-btn { background: #333; color: #fff; }
body.dark-mode .prop-item input, body.dark-mode .prop-item select {
    background: #222; border-color: #444; color: #fff;
}

/* ==========================================
   NOTIFICACIONES TOAST (CALIDAD DE PDF)
   ========================================== */
.toast {
    padding: 12px 20px;
    border-radius: 8px;
    color: white;
    font-weight: bold;
    font-size: 14px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    animation: slideUpFade 0.3s ease forwards;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 90vw;
}
.toast.optimal { background: #28a745; }
.toast.low { background: #ff6b00; }
.toast.medium, .toast.high { background: #0071e3; }

@keyframes slideUpFade {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}
.toast.hiding {
    animation: fadeOut 0.3s ease forwards;
}
@keyframes fadeOut {
    to { opacity: 0; transform: translateY(10px); }
}

/* ==========================================
   BOTÓN DE EDICIÓN RÁPIDA (MODO LLENADO)
   ========================================== */
.inline-edit-btn {
    position: absolute;
    top: -12px;
    right: -12px;
    background: #ff6b00;
    color: white;
    border: 2px solid white;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    font-size: 12px;
    cursor: pointer;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    transition: transform 0.2s, background 0.2s;
}

.inline-edit-btn:hover {
    transform: scale(1.2);
    background: #e65c00;
}

body.dark-mode .inline-edit-btn {
    border-color: #333;
}

/* ==========================================
   BOTÓN DE EDICIÓN RÁPIDA (ESTILO PREMIUM E INVISIBLE)
   ========================================== */
.inline-edit-btn {
    position: absolute;
    top: -8px; 
    right: -8px;
    background: #888888; /* Gris por defecto */
    color: white;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    width: 22px;
    height: 22px;
    font-size: 11px;
    cursor: pointer;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    
    /* TOTALMENTE INVISIBLE Y SIN CLICS POR DEFECTO */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(0.8);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease, background 0.2s ease;
}

/* 1. Mostrar tenue y permitir clics SOLO cuando el usuario pasa el mouse o toca el campo */
.field-rect:hover .inline-edit-btn,
.field-rect:focus-within .inline-edit-btn {
    opacity: 0.4;
    visibility: visible;
    pointer-events: auto;
    transform: scale(1);
}

/* 2. Iluminar totalmente y mostrar vista previa cuando el mouse está sobre el lápiz */
.field-rect .inline-edit-btn:hover {
    opacity: 1 !important;
    background: #ff6b00;
    border-color: white;
    transform: scale(1.1);
    box-shadow: 0 0 10px rgba(255, 107, 0, 0.6);
}

/* 3. Estilo de Vista Previa para el menú flotante */
.floating-popover.preview-mode {
    opacity: 0.6;
    transform: translate(-50%, -100%) scale(0.95) !important;
    box-shadow: 0 4px 15px rgba(255, 107, 0, 0.3);
    border: 1px dashed #ff6b00;
    pointer-events: none; /* No bloquea el clic en el lápiz */
}

/* ==========================================
   EFECTO SHAKE PARA ERRORES EN EL MENÚ
   ========================================== */
@keyframes shakePopover {
    0% { transform: translate(-50%, 0) translateX(0); }
    20% { transform: translate(-50%, 0) translateX(-8px); }
    40% { transform: translate(-50%, 0) translateX(8px); }
    60% { transform: translate(-50%, 0) translateX(-8px); }
    80% { transform: translate(-50%, 0) translateX(8px); }
    100% { transform: translate(-50%, 0) translateX(0); }
}

.shake-effect {
    animation: shakePopover 0.4s ease-in-out;
    border-color: #dc3545 !important;
    box-shadow: 0 0 15px rgba(220, 53, 69, 0.5) !important;
}

/* ==========================================
   NOTIFICACIONES TOAST
   ========================================== */
.toast {
    padding: 12px 20px;
    border-radius: 8px;
    color: white;
    font-weight: bold;
    font-size: 14px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    animation: slideUpFade 0.3s ease forwards;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 90vw;
}
.toast.optimal { background: #28a745; }
.toast.low { background: #ff6b00; }
.toast.medium, .toast.high { background: #0071e3; }

@keyframes slideUpFade {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}
.toast.hiding {
    animation: fadeOut 0.3s ease forwards;
}
@keyframes fadeOut {
    to { opacity: 0; transform: translateY(10px); }
}

/* ==========================================
   MENÚ FLOTANTE (FLEXIBLE Y RESPONSIVO)
   ========================================== */
.floating-popover {
    position: fixed;
    display: none;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid #ddd;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    padding: 12px;
    z-index: 10000;
    width: 95vw; /* Ocupa casi todo el ancho en móvil */
    max-width: 600px; /* Pero no se estira demasiado en PC */
}

#fieldProperties {
