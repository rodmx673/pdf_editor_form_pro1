    background: #ff8533;
}
body.dark-mode .field-rect .inline-edit-btn::after {
    background: #ff6b00;
}

/* ==========================================
   MODO "OCULTAR CAMPOS" (transparente)
   ========================================== */

/* Cuando body tiene la clase 'fields-hidden', todos los field-rect pierden fondo/borde */
body.fields-hidden .field-rect {
    background-color: transparent !important;
    border-color: transparent !important;
    background-image: none !important;
}

/* Inputs dentro de los campos: fondo y borde transparentes, pero TEXTO VISIBLE */
body.fields-hidden .field-rect input,
body.fields-hidden .field-rect input[type="text"],
