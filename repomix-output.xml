    min-width: 300px;
    max-width: 90vw;
    /* Quitamos el transform de aquí para manejarlo con JS */
}

.popover-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid #eee;
