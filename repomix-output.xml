    const dropdown = document.getElementById('hamburgerDropdown');
    dropdown.style.display = dropdown.style.display === 'flex' ? 'none' : 'flex';
});
document.addEventListener('click', (e) => {
    const dropdown = document.getElementById('hamburgerDropdown');
