.prop-item input, .prop-item select { padding: 5px; border-radius: 6px; border: 1px solid #ccc; font-size: 12px; width: 100%; }

/* BOTONES FLOTANTES (FAB) */
.zoom-fab, .fab-pencil { position: fixed; right: 20px; width: 50px; height: 50px; border-radius: 50%; color: white; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.3); z-index: 900; font-size: 20px; cursor: pointer; display: none; align-items: center; justify-content: center; transition: transform 0.2s; }
body.editing-mode .zoom-fab, body.editing-mode .fab-pencil { display: flex; }
.zoom-fab { bottom: 80px; background: rgba(0, 113, 227, 0.9); }
.fab-pencil { bottom: 140px; background: #ff6b00; }
.fab-pencil.active { background: #28a745; box-shadow: 0 0 20px rgba(40, 167, 69, 0.6); }

/* BOTONES COMUNES */
