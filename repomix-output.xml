    btn.innerHTML = isZoomed ? '🔍 100%' : '🔍 +';
    btn.style.background = isZoomed ? 'rgba(40, 167, 69, 0.9)' : 'rgba(0, 113, 227, 0.9)';
    renderPdf();
});

