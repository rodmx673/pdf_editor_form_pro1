}

.header-action-success {
    background: #28a745;
    color: #fff;
    border-color: #28a745;
    box-shadow: 0 2px 8px rgba(40,167,69,0.3);
}

.header-action-success:hover {
    background: #218838;
    border-color: #218838;
}

.header-action-sealed {
    background: #ff6b00;
    color: #fff;
    border-color: #ff6b00;
    box-shadow: 0 2px 8px rgba(255,107,0,0.3);
}

.header-action-sealed:hover {
    background: #e65c00;
    border-color: #e65c00;
}

.header-action-pricing {
    color: #ff6b00;
    border-color: #ff6b00;
}

.header-action-pricing:hover {
    background: #fff3eb;
}

/* Badge en Guardar */
.unsaved-badge {
    display: none;
    position: absolute;
    top: -3px;
    right: -3px;
    width: 11px;
    height: 11px;
    background: #ff3b30;
    border-radius: 50%;
    box-shadow: 0 0 0 2px #fff;
    animation: pulse-badge 1.5s ease-in-out infinite;
}

@keyframes pulse-badge {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.25); }
}

body.dark-mode .header-action-btn {
    background: #2c2c2e;
